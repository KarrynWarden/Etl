# Скопировать в .env и подставить реальные значения.
# Файл .env в .gitignore — в репозиторий не уйдёт.

# --- Пути и режим ---
# FULL_PATH должен заканчиваться на '/'. MODE — суффикс среды (Prod / Test / "").
ETL_FULL_PATH=/opt/airflow/airflow/
ETL_MODE=Prod

# --- Oracle ---
ETL_ORACLE_HOST=10.0.15.9
ETL_ORACLE_PORT=1521
ETL_ORACLE_SID=ias
ETL_ORACLE_USER=имя_пользователя
ETL_ORACLE_PWD=пароль
ETL_ORACLE_CONFIG_DIR=/opt/oracle/config

# --- PostgreSQL ---
ETL_POST_HOST=10.0.15.35
ETL_POST_PORT=5432
ETL_POST_DB=ias5db
ETL_POST_USER=имя_пользователя
ETL_POST_PWD=пароль
