# Скопировать в .env и подставить реальные значения СВОЕГО сегмента (local/test/prod).
# Файл .env в .gitignore — в репозиторий (даже закрытый) не уходит.
#
# Сегмент задаётся не именем переменной, а тем, какой .env загружен: имена
# одинаковые, значения (IP/логины/пароли) — свои у каждого сегмента.

# --- Пути и режим ---
# ETL_FULL_PATH должен заканчиваться на '/'. ETL_MODE — суффикс среды (Prod / Test / "").
ETL_FULL_PATH=/opt/airflow/airflow/
ETL_MODE=Prod

# --- Прочее (актуально для dev-PC) ---
# На dev-PC из-за доменного Kerberos libpq пытается GSSAPI и падает — отключаем:
#PGGSSENCMODE=disable

# --- Oracle: клиент ---
# Каталог с tnsnames.ora/sqlnet.ora. На сервере — /opt/oracle/config.
# На dev-PC (runtime в домашней папке) — например ~/airflow-runtime/opt/oracle/config
ETL_ORACLE_CONFIG_DIR=/opt/oracle/config
# Каталог Instant Client (опционально). Если пусто — ищется через LD_LIBRARY_PATH.
# На dev-PC: ~/airflow-runtime/opt/oracle/instantclient_19_3
#ETL_ORACLE_LIB_DIR=

# --- Oracle: набор реквизитов MAIN (основной пользователь сегмента) ---
ETL_ORACLE_MAIN_HOST=10.0.15.9
ETL_ORACLE_MAIN_PORT=1521
ETL_ORACLE_MAIN_SID=ias
ETL_ORACLE_MAIN_USER=имя_пользователя
ETL_ORACLE_MAIN_PWD=пароль

# --- Oracle: набор реквизитов A56 (второй пользователь, другой логин) ---
ETL_ORACLE_A56_HOST=10.0.15.9
ETL_ORACLE_A56_PORT=1521
ETL_ORACLE_A56_SID=ias
ETL_ORACLE_A56_USER=имя_пользователя2
ETL_ORACLE_A56_PWD=пароль2

# --- PostgreSQL: набор реквизитов MAIN ---
ETL_POST_MAIN_HOST=10.0.15.35
ETL_POST_MAIN_PORT=5432
ETL_POST_MAIN_DB=ias5db
ETL_POST_MAIN_USER=имя_пользователя
ETL_POST_MAIN_PWD=пароль

# --- PostgreSQL: набор реквизитов A56 (второй пользователь) ---
ETL_POST_A56_HOST=10.0.15.35
ETL_POST_A56_PORT=5432
ETL_POST_A56_DB=ias5db
ETL_POST_A56_USER=имя_пользователя2
ETL_POST_A56_PWD=пароль2
