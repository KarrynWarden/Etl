# systemd-сервис: веб-конструктор ETL-дагов (Voilà).
#
# Установка на сервере:
#   sudo cp voila-offline/etl-dagbuilder.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now etl-dagbuilder
#   systemctl status etl-dagbuilder
#
# Порт 8084 (8083 на сервере уже занят другим gunicorn — проверь bash check-ports.sh).
# Прямой доступ по IP закрыт сетью, поэтому смотри README: доступ через SSH-туннель
# (лично) или Apache под существующим доменом (коллегам).

[Unit]
Description=ETL DAG Builder (Voila web UI)
After=network.target

[Service]
Type=simple
# Тот же пользователь, что правит Jupyter-клон; группа etldev — общий доступ.
User=jupyter
Group=etldev
# umask 002 -> файлы, которые генерит приложение, груп-записываемые (правятся с dev-ПК).
UMask=0002
# Каталог общего Jupyter-клона (оттуда импортируется tools/, туда пишутся даги).
WorkingDirectory=/opt/jupyter/workdir/konkin/etl
# Через `python -m voila` (надёжнее, чем путь к бинарнику voila).
# Абсолютный путь к ноутбуку — чтобы не зависеть от рабочего каталога.
ExecStart=/opt/jupyter/bin/python -m voila \
    /opt/jupyter/workdir/konkin/etl/tools/dagbuilder_app.ipynb \
    --no-browser --port=8084 --Voila.ip=0.0.0.0 \
    --VoilaConfiguration.show_tracebacks=True
# Для доступа через Apache по подпути (напр. https://airflow-test.oms66.ru/dagbuilder/)
# добавь к ExecStart:  --base_url=/dagbuilder/   (см. apache-dagbuilder.conf.example).
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
