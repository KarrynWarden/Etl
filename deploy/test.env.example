# Реквизиты ТЕСТОВОГО сегмента для серверного тестового airflow.
# Скопировать в /opt/airflow-test/test-src/.env и вписать реальные значения ТЕСТОВОЙ БД.
# Файл в .gitignore — в репозиторий не уходит и checkout его не затирает.
#
# ETL_FULL_PATH/ETL_MODE задаёт systemd (airflow-test.env) — здесь их НЕ дублируем,
# тут только реквизиты БД, которые читает Src/loadEnv.

# --- Oracle: клиент (на сервере клиент в /opt/oracle) ---
ETL_ORACLE_CONFIG_DIR=/opt/oracle/config
#ETL_ORACLE_LIB_DIR=

# --- Oracle: MAIN (основной пользователь, ТЕСТОВАЯ БД) ---
ETL_ORACLE_MAIN_HOST=
ETL_ORACLE_MAIN_PORT=1521
ETL_ORACLE_MAIN_SID=iastest
ETL_ORACLE_MAIN_USER=
ETL_ORACLE_MAIN_PWD=

# --- Oracle: A56 (второй пользователь, ТЕСТОВАЯ БД) ---
ETL_ORACLE_A56_HOST=
ETL_ORACLE_A56_PORT=1521
ETL_ORACLE_A56_SID=iastest
ETL_ORACLE_A56_USER=
ETL_ORACLE_A56_PWD=

# --- PostgreSQL: MAIN (ТЕСТОВАЯ БД) ---
ETL_POST_MAIN_HOST=
ETL_POST_MAIN_PORT=5432
ETL_POST_MAIN_DB=
ETL_POST_MAIN_USER=
ETL_POST_MAIN_PWD=

# --- PostgreSQL: A56 (ТЕСТОВАЯ БД) ---
ETL_POST_A56_HOST=
ETL_POST_A56_PORT=5432
ETL_POST_A56_DB=
ETL_POST_A56_USER=
ETL_POST_A56_PWD=
