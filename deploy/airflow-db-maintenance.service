# systemd-сервис обслуживания metadata-БД airflow (ПРОД).
# Для теста — drop-in или копия с другими Environment (см. deploy/README.md).
# Установка: cp в /etc/systemd/system/, systemctl daemon-reload.
[Unit]
Description=Airflow metadata DB maintenance (db clean + VACUUM FULL)
After=postgresql.service

[Service]
Type=oneshot
# Прод-параметры. Для теста переопредели SERVICES/PG_DB/ENVFILE.
Environment=SERVICES=airflow-scheduler airflow-webserver
Environment=PG_DB=airflow
Environment=AIRFLOW_HOME=/opt/airflow/airflow
Environment=RETENTION_DAYS=90
# Путь к скрипту — поправь под реальное расположение репозитория на сервере.
ExecStart=/bin/bash /opt/airflow-test/test-src/deploy/airflow-db-maintenance.sh
